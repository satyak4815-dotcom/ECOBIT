# ECOBIT — Environment Variables
# Copy this file to .env.local and fill in the values.

# Google Gemini API Key (used server-side by /api/copilot and /api/policy-scan)
# Get your key at: https://aistudio.google.com/apikey
# IMPORTANT: Do NOT use the VITE_ prefix — this key must remain server-side only.
GEMINI_API_KEY=your_gemini_api_key_here
